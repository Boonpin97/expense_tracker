TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret-here
FIRESTORE_PROJECT_ID=your-gcp-project-id-here
FIRESTORE_DATABASE=(default)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
CLOUD_RUN_URL=https://your-service-url.a.run.app
SCHEDULER_SECRET=your-shared-secret-here
DASHBOARD_WEB_URL=https://your-project-id.web.app
DASHBOARD_WEB_ORIGINS=https://your-project-id.web.app,https://your-project-id.firebaseapp.com
# DEV_MODE=1

# NOTE: there is no TELEGRAM_CHAT_IDS setting. The Telegram allowlist lives in the
# `authorized_chats` Firestore collection (document ID = chat ID) and is watched by a
# realtime listener, so changes take effect without a redeploy.
